# AEGIS Shield build-time settings.
# Copy to aegis-shield/.env.local and fill in. .env.local is gitignored.
# The deploy script writes this file for you when you enter a key.

# CARTO basemap API key (free key: https://carto.com/basemaps/apikey/)
# Required since Sept 2026; without it the map shows "API KEY REQUIRED".
VITE_CARTO_API_KEY=
