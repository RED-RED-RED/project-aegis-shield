[Unit]
Description=KESTREL Node
Documentation=https://github.com/RED-RED-RED/project-kestrel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kestrel-node/kestrel-node
ExecStartPre=/opt/kestrel-node/kestrel-node/systemd/setup_interfaces.sh
ExecStart=/opt/kestrel-node/venv/bin/python agent.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="KESTREL_CONFIG=/etc/kestrel-node/config.yaml"

# Give the service permission to use raw sockets (for HCI + monitor mode)
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
