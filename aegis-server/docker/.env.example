# ============================================================
# AEGIS Server — environment variable template
#
# Setup:
#   cp .env.example .env
#   nano .env           # set DB_PASSWORD, MQTT_PASSWORD (and optionally AEGIS_API_KEY)
#   make server-up
#
# The values below are safe defaults for a private LAN deployment.
# Change all passwords before exposing any port to the internet.
# ============================================================

# ---- Database -----------------------------------------------
# TimescaleDB (PostgreSQL-compatible) — port 5432 inside Docker,
# not exposed to the host by default.
DB_NAME=ridmesh
DB_USER=ridmesh
DB_PASSWORD=changeme

# ---- MQTT ---------------------------------------------------
# Mosquitto broker listens on port 1883 (plain) inside Docker.
# Expose it to the LAN in docker-compose if ARGUS nodes are on a
# different host than the server.
MQTT_PORT=1883
MQTT_USER=rid
MQTT_PASSWORD=changeme

# ---- API authentication (optional) -------------------------
# Leave empty to disable auth on all API endpoints.
# Set to a random secret string to require X-Api-Key header.
# AEGIS_API_KEY=

# ---- Notifications: Pushover (optional) --------------------
# Push HIGH/MEDIUM alerts (and critical node health) to your phone.
# Create a Pushover application for the API token; use your user key
# or a delivery-group key as the recipient. Disabled until enabled.
PUSHOVER_ENABLED=false
# PUSHOVER_TOKEN=your-pushover-app-token
# PUSHOVER_USER=your-user-or-group-key
# PUSHOVER_MIN_LEVEL=medium            # medium | high
# PUSHOVER_COOLDOWN_S=600              # per-drone/node re-push cooldown (escalation overrides)
# PUSHOVER_MAX_PER_HOUR=30             # global flood cap
# Categories that go Emergency (priority 2, repeats until acknowledged):
# PUSHOVER_EMERGENCY_CATEGORIES=spoofed_position,gps_jamming
# PUSHOVER_HEALTH_ENABLED=true         # push on critical node temp/disk
# PUSHOVER_TEMP_CRIT_C=80
# PUSHOVER_DISK_CRIT_PCT=95
